# Copy to .env.local. Server only: never prefix these with NEXT_PUBLIC_.
# AI review stays off until the first four values are all set.

# OpenAI-compatible gateway, for example 9router on the same machine.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
# One fixed model id. Do not use a combo that falls back to other providers.
AI_MODEL=
# Shown to users before they send their CV, so it must name the real provider.
AI_PROVIDER_NAME=

# Optional limits (defaults shown).
# AI_DAILY_LIMIT_PER_CLIENT=5
# AI_DAILY_LIMIT_TOTAL=100

# Optional: address the server uses to reach itself when making PDFs.
# PDF_RENDER_ORIGIN=
